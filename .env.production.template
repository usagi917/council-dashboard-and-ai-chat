# 本番環境用環境変数テンプレート
# 本番デプロイ時にこのファイルを参考に環境変数を設定してください

# アプリケーション設定
NEXT_PUBLIC_SITE_NAME=ikemoto-dashboard

# OpenAI API（本番用キー使用）
# 使用量制限・請求設定を確認済みのキーを使用
# レート制限: text-embedding-3-large 3000 RPM, gpt-4o 500 RPM
OPENAI_API_KEY=sk-prod-your_production_openai_key

# Supabase（本番環境）
# 本番プロジェクトのURL・キーを使用
# RLS（Row Level Security）設定を確認
NEXT_PUBLIC_SUPABASE_URL=https://your_prod_project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_prod_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_prod_service_role_key

# Instagram連携（本番アカウント）
# 長期トークン（60日有効）の定期更新スケジュールを設定
# トークン期限: docs/runbook.md に記録
IG_GRAPH_TOKEN_LONG_LIVED=IGQVDZxxx_prod_long_lived_token
FB_APP_ID=your_prod_facebook_app_id  
FB_APP_CLIENT_TOKEN=your_prod_app_client_token

# 機能フラグ（本番では必ずtrue）
USE_SUPABASE=true

# セキュリティ設定（本番環境推奨）
# CSP設定、CORS設定などNext.js middleware で処理

# ログ・監視設定（将来拡張）
# LOG_LEVEL=info
# APM_TOKEN=your_monitoring_service_token

# キャッシュ設定
# Instagram API: 10-15分キャッシュ（s-maxage=600-900）
# OpenAI Embeddings: 永続キャッシュ（コスト削減）