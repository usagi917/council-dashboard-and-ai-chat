# 政治家ダッシュボード（MVP）環境変数設定例
# このファイルをコピーして .env.local を作成し、実際の値を設定してください

# アプリケーション設定
NEXT_PUBLIC_SITE_NAME=ikemoto-mvp

# OpenAI API設定（サーバーサイドのみ使用）
# https://platform.openai.com/api-keys から取得
OPENAI_API_KEY=sk-your_openai_api_key_here

# Supabase設定
# プロジェクト設定 > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# サーバーサイドのみで使用（Route Handlerで発言データやベクター検索に使用）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Instagram連携設定（Business/Creatorアカウント必須）
# Meta for Developers から取得: https://developers.facebook.com/
# 長期トークンの生成が必要（60日間有効）
IG_GRAPH_TOKEN_LONG_LIVED=IGQVDZxxx...your_long_lived_token_here
FB_APP_ID=your_facebook_app_id_here
FB_APP_CLIENT_TOKEN=your_app_client_token_here

# 機能フラグ（開発用）
# true: Supabaseを使用, false: InMemoryリポジトリを使用
USE_SUPABASE=false